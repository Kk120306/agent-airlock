# Browser/server
HOST=127.0.0.1
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# ModelArk. ARK_MODEL accepts either a Responses-capable Model ID or endpoint ID.
# These defaults match the BytePlus Asia Pacific (Johor) TechJam environment.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=dola-seed-2-1-turbo-260628
# Optional comma-separated, operator-approved fallbacks.
# At most four unique models may be configured across ARK_MODEL and this list.
# Keep Free Credits Only Mode enabled for every activated fallback.
# Confirm remaining free quota in Model activation before adding a fallback.
ARK_MODEL_FALLBACKS=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Local-process paths. Docker Compose overrides these with /app paths.
APP_DATA_DIR=.data
AGENT_WORKSPACE_ROOT=workspaces
CODEX_HOME=codex-home
CODEX_BIN=codex

# The shipped application-container profile requires workspace-write Landlock
# and fails closed when it is unavailable, because mutable Canonical State is
# mounted in that container. The separate disposable Agent Runtime profile may
# use danger-full-access only inside its narrow Candidate-only container.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152
# Maximum number of bounded Repair Runs in one Quarantine lineage.
AIRLOCK_MAX_REPAIR_DEPTH=2
# Mutable Candidate State expires after this many hours unless its Run is active.
AIRLOCK_CANDIDATE_RETENTION_HOURS=24
# Mutable Quarantine expires after this many hours while bounded evidence remains.
AIRLOCK_QUARANTINE_RETENTION_HOURS=168
# Set only by the no-cost npm run demo launcher.
AIRLOCK_DEMO_MODE=false

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# bootstrap-local.sh writes the non-root host UID:GID for Docker Compose.
# start-local-poc.sh uses the current host UID:GID unless explicitly overridden.
# CONTAINER_USER=1000:1000
