{
  "name": "@agent-airlock/portable-promotion-receipt",
  "version": "0.1.0",
  "description": "Offline-verifiable signed Promotion Receipts for Agent Airlock.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-airlock-receipt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/portable-promotion-receipt.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
