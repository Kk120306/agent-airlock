{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-airlock.dev/schema/signed-signing-key-trust-policy-v1.json",
  "title": "Agent Airlock Signed Signing-Key Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "policy",
    "policyDigest",
    "signatureAlgorithm",
    "signature",
    "authorityKeyId",
    "authorityPublicJwk"
  ],
  "properties": {
    "schema": { "const": "agent-airlock/signed-signing-key-trust-policy" },
    "schemaVersion": { "const": 1 },
    "policy": { "$ref": "signing-key-trust-policy.schema.json" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "signatureAlgorithm": { "const": "Ed25519" },
    "signature": { "$ref": "#/$defs/base64url" },
    "authorityKeyId": { "$ref": "#/$defs/digest" },
    "authorityPublicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crv", "kty", "x"],
      "properties": {
        "crv": { "const": "Ed25519" },
        "kty": { "const": "OKP" },
        "x": { "$ref": "#/$defs/base64url" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
