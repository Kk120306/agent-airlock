{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-airlock.dev/schema/signed-policy-authority-rotation-v1.json",
  "title": "Agent Airlock Signed Policy-Authority Rotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "rotation",
    "rotationDigest",
    "signatureAlgorithm",
    "signature",
    "previousAuthorityPublicJwk"
  ],
  "properties": {
    "schema": { "const": "agent-airlock/signed-policy-authority-rotation" },
    "schemaVersion": { "const": 1 },
    "rotation": { "$ref": "policy-authority-rotation.schema.json" },
    "rotationDigest": { "$ref": "#/$defs/digest" },
    "signatureAlgorithm": { "const": "Ed25519" },
    "signature": { "$ref": "#/$defs/base64url" },
    "previousAuthorityPublicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crv", "kty", "x"],
      "properties": {
        "crv": { "const": "Ed25519" },
        "kty": { "const": "OKP" },
        "x": { "$ref": "#/$defs/base64url" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
